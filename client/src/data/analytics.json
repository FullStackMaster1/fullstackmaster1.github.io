{
  "enabled": true,
  "measurementId": "",
  "debugMode": false,
  "eventCategories": {
    "buy_intent": {
      "label": "Buy Intent",
      "description": "User shows purchase interest",
      "events": [
        "book_call_click",
        "view_pricing",
        "pricing_package_click",
        "checkout_intent"
      ]
    },
    "contact_intent": {
      "label": "Contact Intent", 
      "description": "User wants to reach out",
      "events": [
        "whatsapp_click",
        "email_click",
        "linkedin_click",
        "webinar_register"
      ]
    },
    "browse_intent": {
      "label": "Browse Intent",
      "description": "User is exploring content",
      "events": [
        "video_play",
        "course_view",
        "article_read",
        "playlist_view",
        "scroll_to_section"
      ]
    }
  },
  "trackableButtons": {
    "hero": {
      "book_call": { "category": "buy_intent", "action": "hero_book_call" },
      "whatsapp": { "category": "contact_intent", "action": "hero_whatsapp" }
    },
    "navigation": {
      "book_session": { "category": "buy_intent", "action": "nav_book_session" },
      "whatsapp": { "category": "contact_intent", "action": "nav_whatsapp" }
    },
    "pricing": {
      "package_click": { "category": "buy_intent", "action": "pricing_package_click" }
    },
    "footer": {
      "whatsapp": { "category": "contact_intent", "action": "footer_whatsapp" },
      "linkedin": { "category": "browse_intent", "action": "footer_linkedin" },
      "youtube": { "category": "browse_intent", "action": "footer_youtube" }
    },
    "webinar": {
      "register": { "category": "contact_intent", "action": "webinar_register" },
      "upvote": { "category": "browse_intent", "action": "webinar_upvote" }
    },
    "courses": {
      "udemy_click": { "category": "buy_intent", "action": "course_udemy_click" },
      "pluralsight_click": { "category": "buy_intent", "action": "course_pluralsight_click" }
    },
    "playlists": {
      "video_click": { "category": "browse_intent", "action": "playlist_video_click" }
    }
  }
}
